# ─────────────────────────────────────────────────────────────────────────────
# FinanceDashboard — Docker build options (read by compose.yaml).
# Copy to .env and edit. Full documentation: docs/docker-build.md
# ─────────────────────────────────────────────────────────────────────────────

# Requirement check, run by tools/docker-build.* BEFORE anything is built
# (also runnable alone: tools/check-requirements.ps1 / .sh). It checks:
#   - these options are valid;
#   - Docker is installed, running, in Linux-container mode, with enough
#     memory/disk for the chosen LINK_MODE;
#   - the Qt version / llvm-mingw release exist for TARGET + LINK_MODE, and
#     (windows-shared only) that llvm-mingw's LLVM matches the one Qt was
#     built with — static builds compile Qt themselves, so they skip that;
#   - whether THIS computer can run the result (Windows version + CPU for
#     windows; glibc + system libraries for linux — static needs fewer).
# true = run it and stop the build if something FAILs; false = skip it.
CHECK_REQUIREMENTS=true
# true = still build when the check FAILs (failures are still shown and logged).
# Same as passing -Force / --force to the build script once.
FORCE_BUILD=false

# What to build for:
#   windows  → FinanceDashboard.exe (cross-compiled with llvm-mingw / clang)
#   linux    → FinanceDashboard (x86_64 ELF, runs on glibc 2.35+: Ubuntu 22.04+, Debian 12+)
# Either way the output folder holds a small *launcher* (the file you start),
# which checks the requirements, plus the real app in app/ — docs/startup.md.
TARGET=windows

# How Qt is linked:
#   shared → app/ holds the exe + Qt DLLs/.so, plugins/ and qml/ folders.
#            Uses Qt's official prebuilt binaries: image builds in minutes.
#   static → app/ holds a single executable with Qt inside. Qt has no prebuilt static
#            binaries, so the image compiles Qt from source the first time:
#            ~1–3 h and ~20 GB of temporary disk, cached afterwards.
#            Licence note: distributing a statically linked Qt app under
#            Qt's LGPL has extra obligations (fine for personal use).
LINK_MODE=shared

# CMake build type: Release | Debug | RelWithDebInfo | MinSizeRel
# (On Windows, only Release hides the console window.)
BUILD_TYPE=Release

# Qt version. Must exist both as a prebuilt win64_llvm_mingw / linux_gcc_64
# package (shared) and as source tarballs (static) on download.qt.io.
QT_VERSION=6.11.1

# llvm-mingw release (https://github.com/mstorsjo/llvm-mingw/releases).
# Keep it on the same LLVM version Qt's win64_llvm_mingw binaries were built
# with (Qt 6.11.1 → LLVM 17.0.6 → release 20231128), or libc++ may mismatch.
LLVM_MINGW_VERSION=20231128

# Parallel jobs. Empty = all CPU cores. Lower QT_BUILD_JOBS if the static Qt
# build runs out of memory (Docker Desktop → Settings → Resources).
BUILD_JOBS=
QT_BUILD_JOBS=

# Linux/macOS hosts only: run the build as your user so build-docker/ and
# dist/ aren't owned by root. Set to the output of `id -u` / `id -g`.
#HOST_UID=1000
#HOST_GID=1000
